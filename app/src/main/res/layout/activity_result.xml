<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/resultColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp">

        <!-- ── 本卦 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/result_ben"
            android:textColor="@color/text_faint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/nameBen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_primary"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/trigramBen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <com.wearcast.liuyao.view.HexagramView
            android:id="@+id/hexBen"
            android:layout_width="86dp"
            android:layout_height="104dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/moving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/cinnabar"
            android:textSize="11sp" />

        <!-- ── 变卦（有动爻时才显示，与本卦上下分区而非左右双列） ── -->
        <LinearLayout
            android:id="@+id/bianBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/result_bian"
                android:textColor="@color/text_faint"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/nameBian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_primary"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/trigramBian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <com.wearcast.liuyao.view.HexagramView
                android:id="@+id/hexBian"
                android:layout_width="86dp"
                android:layout_height="104dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ── 卦辞 ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/result_gua_ci"
            android:textColor="@color/text_faint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/guaCi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/yaoCiTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/result_yao_ci"
            android:textColor="@color/text_faint"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/yaoCi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 用九 / 用六：只有乾、坤两卦有 -->
        <TextView
            android:id="@+id/yongCi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/coin"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- ── 断语（本版只出经文原文，断语留空占位） ── -->
        <TextView
            android:id="@+id/duanCiTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/result_duan_ci"
            android:textColor="@color/text_faint"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/duanCi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_faint"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnAgain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/result_again"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/result_footer"
            android:textColor="@color/text_faint"
            android:textSize="9sp" />
    </LinearLayout>

</ScrollView>
