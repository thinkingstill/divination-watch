<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 顶部回纹带：圆表上按所在行弦宽自动收窄 -->
    <com.wearcast.liuyao.view.MeanderBandView
        android:id="@+id/bandTop"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:id="@+id/homeColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingTop="6dp"
        android:paddingRight="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.3"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <com.wearcast.liuyao.view.CoinTossView
            android:id="@+id/coin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="2dp" />

        <!-- 两个并列入口：左「一键」（铜金实心），右「沉浸」（铜金描边） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnQuick"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_cast_button_solid"
                    android:contentDescription="@string/cast_mode_quick"
                    android:gravity="center"
                    android:text="@string/home_quick"
                    android:textColor="@color/bg"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/home_quick_sub"
                    android:textColor="@color/text_faint"
                    android:textSize="10sp" />
            </LinearLayout>

            <Space
                android:layout_width="14dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnImmersive"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_cast_button"
                    android:contentDescription="@string/cast_mode_immersive"
                    android:gravity="center"
                    android:text="@string/home_immersive"
                    android:textColor="@color/coin"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/home_immersive_sub"
                    android:textColor="@color/text_faint"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/homeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/home_hint_default"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:text="@string/sound_off"
            android:textColor="@color/text_faint"
            android:textSize="10sp" />
    </LinearLayout>

</FrameLayout>
